# Application
APP_NAME=风控后台
SECRET_KEY=your-secret-key-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
DATABASE_URL=sqlite+aiosqlite:///./risk_control.db

# Lark OAuth
LARK_APP_ID=your-lark-app-id
LARK_APP_SECRET=your-lark-app-secret
LARK_REDIRECT_URI=http://localhost:8000/api/auth/lark/callback

# AI Service (OpenAI compatible)
AI_API_KEY=your-ai-api-key
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4

# ThinkingData (数数) API
TD_API_URL=https://your-td-instance.thinkingdata.cn
TD_API_TOKEN=your-td-api-token
TD_APP_ID=your-td-app-id

# Risk Model Service
RISK_MODEL_API_URL=http://your-risk-model-service:8080
RISK_MODEL_API_KEY=your-risk-model-api-key

# Frontend
FRONTEND_URL=http://localhost:3000

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

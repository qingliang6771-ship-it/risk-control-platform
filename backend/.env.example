# ============================================================
# 风控后台 环境变量模板
# 复制为 backend/.env 并填写真实值后再部署
#   cp backend/.env.example backend/.env
# ============================================================

# ---------- 应用 ----------
APP_NAME=Risk Control Platform
DEBUG=false
# 前端访问地址（部署脚本会自动用 SERVER_URL 覆盖）
FRONTEND_URL=http://your-server-ip

# ---------- 数据库（单机 Docker 默认用 SQLite，持久化到 data 卷）----------
DATABASE_URL=sqlite+aiosqlite:///./db/risk_control.db


# ---------- JWT ----------
# 生产环境务必改成随机字符串： openssl rand -hex 32
SECRET_KEY=change-me-please-use-a-random-64-char-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---------- Lark(飞书) OAuth 登录 ----------
LARK_APP_ID=cli_xxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxx
# 必须与 Lark 开放平台后台配置的重定向 URL 完全一致
LARK_REDIRECT_URI=http://your-server-ip/api/auth/lark/callback

# ---------- AI 服务 ----------
AI_API_KEY=sk-xxxxxxxxxxxx
AI_BASE_URL=https://api.servetokens.com/v1
AI_MODEL=claude-sonnet-4-6

# ---------- 数数 ThinkingData API ----------
TA_API_URL=https://your-ta-instance.thinkingdata.cn
TA_API_TOKEN=xxxxxxxxxxxx
TA_APP_ID=xxxxxxxxxxxx

# ---------- 风控模型服务 ----------
RISK_MODEL_BASE_URL=http://your-risk-model-host:9000
RISK_MODEL_API_KEY=xxxxxxxxxxxx

# ---------- CORS（生产可留空，同源部署无需跨域）----------
# CORS_ORIGINS=["http://your-server-ip"]
